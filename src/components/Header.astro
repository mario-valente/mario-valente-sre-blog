---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  altPaths?: Partial<Record<Lang, string>>;
}

const { lang, altPaths } = Astro.props;
const t = useTranslations(lang);

const nav = [
  { href: `/${lang}/`, label: t('nav.home') },
  { href: `/${lang}/blog/`, label: t('nav.blog') },
  { href: `/${lang}/tags/`, label: t('nav.tags') },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 dark:border-ink-700/70 bg-white/80 dark:bg-ink-950/80 backdrop-blur">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href={`/${lang}/`} class="flex items-center gap-2 font-mono font-bold text-lg group">
      <span class="text-uptime-green group-hover:animate-pulse">●</span>
      <span>mario<span class="text-signal-cyan">@</span>sre</span>
    </a>

    <nav class="hidden sm:flex items-center gap-6 font-mono text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-slate-600 dark:text-slate-300 hover:text-signal-cyan dark:hover:text-uptime-green transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <LangSwitcher lang={lang} altPaths={altPaths} />
      <ThemeToggle lang={lang} />
    </div>
  </div>

  <nav class="sm:hidden flex items-center gap-4 px-4 pb-3 font-mono text-sm overflow-x-auto">
    {nav.map((item) => (
      <a href={item.href} class="text-slate-600 dark:text-slate-300 hover:text-signal-cyan whitespace-nowrap">
        {item.label}
      </a>
    ))}
  </nav>
</header>
