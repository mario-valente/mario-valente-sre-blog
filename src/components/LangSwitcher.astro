---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Optional map of lang -> exact path to link to (e.g. a post's translation). Falls back to root. */
  altPaths?: Partial<Record<Lang, string>>;
}

const { lang, altPaths } = Astro.props;
const entries = Object.entries(languages) as [Lang, string][];
---

<div class="relative group">
  <button
    type="button"
    class="flex items-center gap-1 rounded-full border border-slate-300 dark:border-ink-600 px-3 h-9 text-sm font-mono text-slate-600 dark:text-slate-200 hover:border-signal-cyan hover:text-signal-cyan dark:hover:text-uptime-green transition-colors"
    aria-haspopup="true"
  >
    {lang.toUpperCase()}
    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
    </svg>
  </button>
  <div class="invisible group-hover:visible group-focus-within:visible opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity absolute right-0 mt-1 w-40 rounded-lg border border-slate-200 dark:border-ink-700 bg-white dark:bg-ink-900 shadow-lg py-1 z-50">
    {entries.map(([code, label]) => (
      <a
        href={altPaths?.[code] ?? `/${code}/`}
        class={`block px-3 py-2 text-sm font-mono hover:bg-slate-100 dark:hover:bg-ink-800 ${
          code === lang ? 'text-signal-cyan font-semibold' : 'text-slate-600 dark:text-slate-300'
        }`}
      >
        {label}
      </a>
    ))}
  </div>
</div>
