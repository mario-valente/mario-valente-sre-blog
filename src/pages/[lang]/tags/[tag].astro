---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { useTranslations } from '../../../i18n/utils';
import { languages, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths: { params: { lang: string; tag: string } }[] = [];
  for (const lang of Object.keys(languages)) {
    const posts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
    const tags = new Set(posts.flatMap((p) => p.data.tags));
    for (const tag of tags) {
      paths.push({ params: { lang, tag } });
    }
  }
  return paths;
}

const { lang, tag } = Astro.params as { lang: Lang; tag: string };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts
  .filter((p) => p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={`#${tag} — Mario Valente`} lang={lang}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-16">
    <p class="font-mono text-sm text-slate-500 mb-2">{t('tags.postsTagged')}</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-10">#{tag}</h1>
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
