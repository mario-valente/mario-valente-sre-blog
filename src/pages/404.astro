---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Mario Valente" lang="en">
  <section class="mx-auto max-w-2xl px-4 sm:px-6 py-32 text-center">
    <p class="font-mono text-6xl font-extrabold text-incident-magenta mb-4">404</p>
    <h1 class="text-2xl font-bold mb-3">Page not found</h1>
    <p class="text-slate-600 dark:text-slate-400 mb-8">
      Looks like this endpoint returned a non-2xx status. Let's get you back to a healthy route.
    </p>
    <a
      href="/pt/"
      class="inline-flex items-center gap-2 rounded-full bg-signal-cyan text-ink-950 font-mono font-semibold px-6 py-3 hover:bg-uptime-green transition-colors"
    >
      ← Back home
    </a>
  </section>
</BaseLayout>
